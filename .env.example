# ==============================
# Service Configuration
# ==============================
APP_ENV=development
DEBUG=true
LOG_LEVEL=debug

# ==============================
# API Server
# ==============================
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000

# ==============================
# Database (PostgreSQL)
# ==============================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=papertoprod
POSTGRES_USER=papertoprod
POSTGRES_PASSWORD=changeme_in_production

DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ==============================
# Redis
# ==============================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0

# ==============================
# Celery
# ==============================
CELERY_BROKER_URL=redis://${REDIS_HOST}:${REDIS_PORT}/1
CELERY_RESULT_BACKEND=redis://${REDIS_HOST}:${REDIS_PORT}/2

# ==============================
# Qdrant (Vector Store)
# ==============================
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_URL=http://${QDRANT_HOST}:${QDRANT_PORT}

# ==============================
# MinIO (S3-compatible Object Store)
# ==============================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_PAPERS=papers
MINIO_BUCKET_JOBS=jobs
MINIO_USE_SSL=false

# ==============================
# Authentication
# ==============================
JWT_SECRET_KEY=changeme_generate_a_real_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/auth/callback/github

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/callback/google

# ==============================
# GitHub App (for Finder Agent)
# ==============================
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_WEBHOOK_SECRET=

# ==============================
# LLM Providers
# ==============================
# Primary: Anthropic (Claude)
ANTHROPIC_API_KEY=

# Fallback: OpenAI
OPENAI_API_KEY=

# Model configuration
PRIMARY_MODEL=claude-sonnet-4-20250514
FALLBACK_MODEL=gpt-4o
CHEAP_MODEL=gpt-4o-mini

# ==============================
# Sandbox Execution Service
# ==============================
SANDBOX_SERVICE_URL=http://localhost:8001
SANDBOX_MAX_EXECUTION_TIME_SECONDS=600
SANDBOX_MAX_MEMORY_MB=4096
SANDBOX_MAX_RETRIES=5

# ==============================
# Frontend (Next.js)
# ==============================
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
